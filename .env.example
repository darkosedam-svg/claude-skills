# Helius / Solana — environment template
#
# Copy to `.env` and fill in real values. `.env` is gitignored; this file is not.
#     cp .env.example .env
#
# Used by the Helius Claude Code plugin (helius@helius-labs, github.com/helius-labs/core-ai)
# and by any Solana app scaffolded with its skills.
#
# ─────────────────────────────────────────────────────────────────────────────
# NEVER prefix any key below with NEXT_PUBLIC_ or VITE_. Those prefixes embed
# the value into the client bundle at build time, where anyone can read it.
# Keys are server-side only — proxy browser calls through your own backend and
# rate limit that proxy. The one exception is Helius Sender
# (https://sender.helius-rpc.com/fast), which is browser-safe without a key.
# ─────────────────────────────────────────────────────────────────────────────

# --- Helius (required) -------------------------------------------------------
# Get one at https://dashboard.helius.dev, or let the plugin run signup for you.
# When this is set, the plugin's MCP tools auto-detect it — no setup call needed.
HELIUS_API_KEY=

# mainnet-beta (default) or devnet
HELIUS_NETWORK=mainnet-beta

# Derived from the key; set explicitly only to pin a region or a staging host.
# HELIUS_RPC_URL=https://mainnet.helius-rpc.com/?api-key=${HELIUS_API_KEY}

# Overrides the hosted payment/signup host. Rarely needed.
# HELIUS_PAYMENT_HOST=https://dashboard.helius.dev

# --- Jupiter (optional) ------------------------------------------------------
# Only needed for DeFi work via the /helius:jupiter skill.
# JUPITER_API_KEY=

# --- DFlow (optional) --------------------------------------------------------
# Dev endpoints work with no key but are rate-limited. For production, request
# a key at https://pond.dflow.net/build/api-key
# DFLOW_API_URL=https://dev-quote-api.dflow.net
# Vault password for the DFlow Agent CLI in headless environments.
# DFLOW_PASSPHRASE=

# --- OKX (optional) ----------------------------------------------------------
# Only needed for DEX aggregation via the /helius:okx skill.
# OKX_API_KEY=
# OKX_SECRET_KEY=
# OKX_PASSPHRASE=
